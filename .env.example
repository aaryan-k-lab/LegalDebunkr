# --- Azure AI Document Intelligence (layout + OCR) ---
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- Azure AI Content Understanding (structured field extraction) ---
# Usually the same Azure AI Services (multi-service) resource works for both.
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://<your-ai-services-resource>.services.ai.azure.com/
AZURE_CONTENT_UNDERSTANDING_KEY=
AZURE_CONTENT_UNDERSTANDING_API_VERSION=2025-05-01-preview
AZURE_CONTENT_UNDERSTANDING_ANALYZER_ID=legaldebunkr-analyzer
# Only needed if your API version requires a base analyzer / model deployments (GA versions):
AZURE_CONTENT_UNDERSTANDING_BASE_ANALYZER_ID=
AZURE_CONTENT_UNDERSTANDING_COMPLETION_MODEL=

# --- Azure OpenAI (plain-English language generation) ---
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- App ---
MAX_UPLOAD_MB=15
MAX_SECTIONS=40

# --- Abuse and cost protection (defaults shown) ---
# Limits per client IP. Format: "<n> per minute;<n> per day"
RATE_LIMIT_ANALYZE=5 per minute;30 per day
RATE_LIMIT_ASK=20 per minute;200 per day
RATE_LIMIT_DEFAULT=120 per minute
# Use redis://host:6379 if you run more than one worker or instance.
RATELIMIT_STORAGE_URI=memory://
MAX_CONCURRENT_ANALYSES=4
# Number of reverse proxies in front of the app (0 when running directly).
TRUST_PROXY_HOPS=0
STORE_TTL_SECONDS=3600
STORE_MAX_ITEMS=200
# Never set to 1 on a public server.
FLASK_DEBUG=0
